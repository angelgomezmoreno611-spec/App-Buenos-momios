# Demo: datos inventados, sin cuentas ni llamadas a proveedores.
DATA_MODE=demo
PORT=3000
APP_TIMEZONE=America/Mazatlan
ALLOWED_ORIGIN=http://localhost:8080

# Producción: DATA_MODE=live. Todo lo siguiente es SOLO del servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Opcional: se puede derivar de SUPABASE_URL; el diagnóstico comprueba su acceso.
# Las sesiones de usuarios se verifican contra Supabase Auth, no con esta URL.
SUPABASE_JWKS_URL=
# Compatibilidad con proyectos antiguos:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
FOOTBALL_DATA_TOKEN=
# Fuentes adicionales para información de partidos (claves solo del servidor).
# OpenLigaDB y OpenFootball funcionan sin claves.
API_FOOTBALL_KEY=
SPORTMONKS_TOKEN=
# Vacío usa la clave pública 123 y sus límites de muestra.
THESPORTSDB_API_KEY=
ALLSPORTS_API_KEY=
ODDS_API_KEY=
# Hasta 8 ligas del plan gratuito. Solo ligas, sin eliminatorias.
FOOTBALL_COMPETITIONS=PL,PD,BL1,SA,FL1,DED,PPL,ELC,BSA
CRON_SECRET=
# Cada partido debe superar este umbral. No es una precisión validada.
MIN_PROBABILITY=0.65
# Servicio de Firebase: JSON de cuenta de servicio en UNA línea.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Ligas CSV de football-data.co.uk (uso personal; máx. 2 descargas/semana vía /api/jobs/csv).
# Por defecto las validadas: NOR,SWE,CHN,SWZ,T1,DNK,USA. "none" las desactiva.
# CSV_COMPETITIONS=NOR,SWE,CHN,SWZ,T1,DNK,USA
