{
  "name": "buenos-momios-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --max-old-space-size=512 --env-file-if-exists=.env src/server.js",
    "start": "node --max-old-space-size=512 src/server.js",
    "test": "node --max-old-space-size=512 --test --test-concurrency=1",
    "check:supabase": "node --max-old-space-size=512 --env-file-if-exists=.env scripts/check-supabase.js",
    "check:football": "node --max-old-space-size=512 --env-file-if-exists=.env scripts/check-football.js",
    "backtest": "node --max-old-space-size=512 scripts/backtest.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15"
  }
}
